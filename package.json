{
  "name": "carestickers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --port=3000 --host=0.0.0.0\" \"tsx watch server/src/index.ts\"",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "lint:functions": "tsc --noEmit -p supabase/functions/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "build:cap": "cross-env CAPACITOR_BUILD=true vite build && npx cap sync",
    "build:cap:local": "cross-env CAPACITOR_BUILD=true vite build --mode capacitor-local && npx cap sync",
    "build:cap:ios-local": "cross-env CAPACITOR_BUILD=true vite build --mode capacitor-ios-local && npx cap sync ios",
    "build:cap:staging": "cross-env CAPACITOR_BUILD=true vite build --mode capacitor-staging && npx cap sync",
    "build:cap:prod": "cross-env CAPACITOR_BUILD=true vite build --mode capacitor-production && npx cap sync",
    "cap:sync": "npx cap sync",
    "assets:placeholders": "node scripts/generate-placeholder-assets.mjs",
    "assets:generate": "capacitor-assets generate --ios --android",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "local:up": "node scripts/local-up.mjs web",
    "local:up:android": "node scripts/local-up.mjs android",
    "local:up:ios": "node scripts/local-up.mjs ios",
    "local:up:all": "node scripts/local-up.mjs all",
    "local:down": "node scripts/local-down.mjs",
    "docker:up": "docker compose -f docker-compose.yml build && docker compose -f docker-compose.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml down",
    "docker:db": "docker compose -f docker-compose.yml up -d db",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migration:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts",
    "db:types:local": "supabase gen types typescript --local > src/types/database.ts",
    "functions:serve": "supabase functions serve",
    "functions:deploy": "supabase functions deploy"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/push-notifications": "^7.0.7",
    "@fontsource-variable/lexend": "^5.2.11",
    "@supabase/server": "^1.3.0",
    "@supabase/supabase-js": "^2.110.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "jsdom": "^29.0.2",
    "pg-mem": "^3.0.14",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
