# Capacitor PRODUCTION build config (used by `npm run build:cap:prod` via Vite mode
# `capacitor-production`). Only public client (VITE_*) values belong here — never secrets.
# These override `.env` / `.env.local` for this mode.

# Full base URL of the production API, no trailing slash. The Capacitor WebView is not
# same-origin with the server, so this is required for native builds.
VITE_API_BASE=https://api.example.com

# Production Supabase project (anon key is public by design).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<production-anon-or-publishable-key>
