# Capacitor STAGING build config (used by `npm run build:cap:staging` via Vite mode
# `capacitor-staging`). Only public client (VITE_*) values belong here — never secrets.
# These override `.env` / `.env.local` for this mode.

# Full base URL of the staging API, no trailing slash. The Capacitor WebView is not
# same-origin with the server, so this is required for native builds.
VITE_API_BASE=https://api-staging.example.com

# Staging Supabase project (anon key is public by design).
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<staging-anon-or-publishable-key>
